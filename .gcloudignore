#!include:.gitignore

# Always exclude VCS and local deps
.git
node_modules

# Local-only artifacts / secrets
.env
.env.*
.DS_Store

# Build artifacts (built in Cloud Build)
dist
tmp

# Dev-only / bulky artifacts
docs
tests
scripts/preview
scripts/test
scripts/export
scripts/ops
relation_pdf
coverage
.nyc_output

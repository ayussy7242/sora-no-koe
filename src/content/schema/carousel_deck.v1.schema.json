{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "carousel_deck.v1.schema.json",
  "title": "Carousel Deck (v1)",
  "type": "object",
  "required": ["type", "version", "layout_key", "slides"],
  "properties": {
    "type": { "const": "carousel_deck" },
    "version": { "const": "v1" },
    "layout_key": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "badge": { "type": "string" },
    "data": { "type": "object" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slide" }
    }
  },
  "definitions": {
    "date_local": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time_local": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "row": {
      "type": "object",
      "required": ["date_local", "sign_key"],
      "properties": {
        "date_local": { "$ref": "#/definitions/date_local" },
        "time_local": { "oneOf": [ { "$ref": "#/definitions/time_local" }, { "type": "null" } ] },
        "sign_key": { "type": "string", "minLength": 1 },
        "moon_name_ja": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
        "moon_name_en": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
        "special_name_ja": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
        "special_name_en": { "oneOf": [ { "type": "string" }, { "type": "null" } ] }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "tagline": { "type": "string" },
        "badge": { "type": "string" },
        "source": { "type": "string" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/definitions/row" }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "table" } }
          },
          "then": {
            "required": ["source"],
            "properties": {
              "source": { "enum": ["full_moons", "new_moons"] }
            }
          }
        }
      ]
    }
  }
}

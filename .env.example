# Core
PROJECT=sora-no-koe
SCHEMA_VERSION=1.0.0
NODE_ENV=development
DEFAULT_TZ=Asia/Tokyo
PORT=8080

# Firestore
FIRESTORE_DATABASE_ID=sora-no-koe-db

# Swiss Ephemeris
SWISSEPH_PATH=/usr/share/swisseph

# Precision / astrology
PRECISION_DEG=0.01
ORB_DEG=6
ORB_MAX_DEG=6

# LINE Messaging API
LINE_ENABLED=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_STRICT=false
BOT_NAME=
LINE_ACCOUNT_NAME=
OWNER_LINE_USER_ID=
IG_STORY_DELIVERY_LINE_USER_ID=
LINE_ADD_FRIEND_URL=
MAX_LINE_TEXT=4800

# Profile
OWNER_APP_USER_ID=

# Google Maps / Geo
GOOGLE_MAPS_API_KEY=
GEO_CACHE_COLLECTION=geo_cache
GEO_CACHE_TTL_DAYS=180
GEO_DEFAULT_LANGUAGE=ja
GEO_DEFAULT_REGION=jp

# cron / debug
CRON_TOKEN=
DEBUG_TOKEN=
HEALTH_DB_PING=false

# Feature flags
FEATURE_PAID_DEEP_ASPECTS=false
FEATURE_AI_EXPANSION=false

# Paid mode
PAID_MODE_ENABLED=false
PAID_INTENTS=today_distribution
PAID_ALLOW_APP_USER_IDS=
PAID_ALLOW_LINE_USER_IDS=
PAID_ALLOW_OWNER=true
PLUS_ENABLED=false

# Worker
WORKER_PUSH_NATAL_RESULT=0
WORKER_PUSH_ONLY_LINE_USER_ID=

# WordPress (BLOG)
WP_BASE_URL=
WP_USER=
WP_APP_PASSWORD=
WP_CATEGORY_DAILY=10
WP_CATEGORY_SIGN=7
WP_CATEGORY_PLANET=5
WP_CATEGORY_ASPECT=9
BLOG_RECO_ENABLED=true
BLOG_RECO_COUNT=3
BLOG_WHEEL_ENABLED=true
BLOG_EYECATCH_ENABLED=false
BLOG_EYECATCH_BG_MODE=image
BLOG_EYECATCH_FORCE=false
BLOG_EYECATCH_BG_PATH=
BLOG_EYECATCH_PRESET=C
BLOG_AUTO_PUBLISH=false
BLOG_HIDE_AFTER_RESONANCE=false

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_BLOG=gpt-4o-mini
OPENAI_MODEL_BLOG_PARTS=gpt-4o-mini
BLOG_GEN_MODE=single
OPENAI_MODEL_BLUEPRINT_LIGHT=

# Stripe / Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_LINE_500=
STRIPE_PAYMENT_LINK_LIGHT=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
SORA_PLUS_URL=

# Public URL / GCS
PUBLIC_BASE_URL=
GCS_BUCKET_BLUEPRINTS=
GCS_BUCKET_SORA=
RELATION_PDF_BUCKET=
BLUEPRINT_URL_EXPIRES_DAYS=7
BLUEPRINT_BG_REGEN=true
SORA_WHEEL_URL_EXPIRES_DAYS=2
RELATION_PDF_URL_EXPIRES_DAYS=7

# Instagram (Graph API)
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_USER_ID=
IG_PAGE_ID=
IG_GRAPH_VERSION=v19.0
IG_GCS_BUCKET=
IG_IMAGE_URL_EXPIRES_DAYS=7
IG_POST_DRY_RUN=false

# Cloud Tasks (Blueprint)
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=blueprint-generate
BLUEPRINT_GENERATE_URL=
BLUEPRINT_WORKER_URL=
TASKS_CALLER_SA_EMAIL=
INTERNAL_TASKS_TOKEN=
